---
export interface Props {
  title: string;
  anchor?: string;
  isDark?: boolean;
}

const { title, anchor, isDark = false } = Astro.props;
---

<section
  id={anchor}
  class:list={[
    'flex px-12 py-16',
    isDark ? 'bg-panel text-white' : 'bg-canvas',
  ]}
>
  <div
    class:list={[
      'container max-w-5xl mx-auto flex flex-col items-center',
      'lg:space-x-36 lg:flex-row',
    ]}
  >
    <div class="flex-1">
      <h3 class="mb-4 text-xl lg:text-2xl font-semibold">{title}</h3>
      <div class="font-light">
        <slot name="description" />
      </div>
      <slot />
    </div>
  </div>
</section>
